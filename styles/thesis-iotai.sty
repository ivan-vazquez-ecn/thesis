% =========================================================
% --- Cover ---
% =========================================================
\newcommand{\director}[1]{\gdef\@director{#1}}
\newcommand{\@director}{\@latex@warning@no@line{No \noexpand\director given}}

\newcommand{\degree}[1]{\gdef\@degree{#1}}
\newcommand{\@degree}{Maestro en Ingeniería}

\newcommand{\program}[1]{\gdef\@program{#1}}
\newcommand{\@program}{Maestría en Ingeniería en Internet de las Cosas e Inteligencia Artificial}

\newcommand{\city}[1]{\gdef\@city{#1}}
\newcommand{\@city}{HERMOSILLO, SONORA, MÉXICO.}

\newcommand{\logo}[1]{\gdef\@logo{#1}}
\newcommand{\@logo}{figures/ESCUDO-COLOR.png} % Default path

\newcommand{\makecover}{%
  \begin{titlepage}
    \setlength{\parskip}{0pt}
    \newgeometry{top=2.2cm, bottom=2.2cm, left=2.5cm, right=2.5cm}
    \thispagestyle{empty}
    \centering

    % 1. Institutional Top Header
    \begin{tblr}{
      width   = \linewidth,
      colspec = {Q[c, m]},
      row{1}  = {font = \huge\bfseries},
      row{2}  = {font = \LARGE\bfseries},
      row{3}  = {font = \LARGE\bfseries},
      rowsep  = 2pt
    }
      UNIVERSIDAD DE SONORA \\
      Facultad Interdisciplinaria de Ingeniería \\
      Departamento de Ingeniería Industrial
    \end{tblr}
    \vspace{1em}

    % 2. University Logo
    \includegraphics[height=1.75in, keepaspectratio]{\@logo}
    \vspace{1em}

    % 3. Master's Program Header
    {\Large {POSGRADO EN INGENIERÍA INDUSTRIAL\par}}
    {\large\bfseries \MakeUppercase{\@program}\par}
    \vspace{1.2em}

    % 4. Thesis Title & Degree Metadata
    {\Large\bfseries \@title\par}
    \vspace{1.2em}

    {\huge \textbf{T\, E\, S\, I\, S}\par}
    \vspace{1.2em}

    {\normalsize PRESENTADA POR\par}
    {\Large\bfseries \MakeUppercase{\@author}\par}
    \vspace{1.2em}

    {\fontsize{10pt}{11pt}\selectfont Desarrollada para cumplir con uno de los \\requerimientos parciales para obtener \\el grado de \@degree\par}
    \vspace{1em}

    \vspace{1.2em}

    % 5. Advisory Committee
    {\Large DIRECTOR DE TESIS\par}
    {\Large \MakeUppercase{\@director}\par}

    \vfill

    % 6. Footer: Location and Date
    \noindent
    {\fontsize{16pt}{20pt}\selectfont \@city \hfill \MakeUppercase{\@date}\par}

    % \vspace*{5pt}
    \restoregeometry
  \end{titlepage}
  \clearpage
}


